# CarPlay (sheldon as the iPhone). Off by default: it takes the only USB port away from adb.
#   adb tcpip 5555; adb connect <ip>; adb shell setprop persist.vendor.carplay.enable 1
# Logs: adb logcat -s catplay_android (logwrapper tag)
on property:persist.vendor.carplay.enable=1
    insmod /vendor/lib/modules/iap2_char.ko
    insmod /vendor/lib/modules/iap2_usb_bulk.ko
    insmod /vendor/lib/modules/iap2_scan.ko
    insmod /vendor/lib/modules/iap2_hid.ko
    insmod /vendor/lib/modules/g_iphone.ko
    insmod /vendor/lib/modules/hid-multitouch.ko
    # g_iphone switches the mtu3 role through debugfs usb/<udc>/mode
    mount debugfs debugfs /sys/kernel/debug
    # the car's NCM link is IPv6 link-local only
    write /proc/sys/net/ipv6/conf/default/disable_ipv6 0
    mkdir /data/vendor/carplay 0700 root root
    # Android policy routing has no "lookup main" rule, so connecting to the car's fe80::%usb0 gave
    # ENETUNREACH. Send usb0-bound traffic to main (where the kernel puts the link-local route).
    # ponytail: assumes the car NCM iface is usb0 (seen on the LG unit); add usb1 if another car differs
    exec u:r:su:s0 root root -- /system/bin/ip -6 rule del oif usb0 lookup main pref 5000
    exec u:r:su:s0 root root -- /system/bin/ip -6 rule add oif usb0 lookup main pref 5000
    # USB adb off, otherwise init + adbd retry binding g1 to the UDC every second (EBUSY loop)
    setprop sys.usb.config none

# daemon only once Android is up (wm/scrcpy need system_server); also fires when enabled at runtime
on property:sys.boot_completed=1 && property:persist.vendor.carplay.enable=1
    start vendor.catplay

# also catches boot (persist.sys.usb.config=adb) with CarPlay left enabled
on property:sys.usb.config=adb && property:persist.vendor.carplay.enable=1
    setprop sys.usb.config none

# runs after the stock "sys.usb.config=none" action (which stops adbd): without ep0, adbd is TCP only
on property:sys.usb.config=none && property:persist.vendor.carplay.enable=1
    umount /dev/usb-ffs/adb
    start adbd

on property:persist.vendor.carplay.enable=0
    stop vendor.catplay
    exec u:r:su:s0 root root -- /system/bin/ip -6 rule del oif usb0 lookup main pref 5000
    write /sys/class/iphone/remove default
    stop adbd
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    # ponytail: back to plain adb; UsbDeviceManager re-applies mtp etc. if the user had them
    setprop sys.usb.config adb

service vendor.catplay /system/bin/logwrapper /system/bin/catplay_android
    user root
    group root
    seclabel u:r:su:s0
    disabled
